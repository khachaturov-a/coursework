        }),
        new("Что для вас самое важное прямо сейчас?", new()
        {
            new("А", "Успех, статус и признание окружающих", "J"),
            new("Б", "Найти способ успокоить вечно занятую голову", "A"),
            new("В", "Духовное развитие и внутренний покой", "B"),
        }),
        new("Как вы справляетесь с трудностями?", new()
        {
            new("А", "Иду в лес или парк — природа всегда лечит", "C"),
