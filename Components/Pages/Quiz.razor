            30),

        ["H"] = new("«Сталь 316L» матовая", "Тип: Рационалист",
            "metal", "bi-link-45deg", "Металлические",
            "Вам не нужны украшения ради украшений — нужно то, что работает.",
            "Медицинская нержавеющая сталь 316L: не темнеет, не окисляется, гипоаллергенная. Абсолютная надёжность без лишних слов — именно то, что ценит прагматичная и целеустремлённая натура.",
            39),

        ["I"] = new("«Греческие» из оливкового дерева", "Тип: Ценитель и эстет",
            "coll", "bi-award", "Коллекционные",
