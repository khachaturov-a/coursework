            new("В", "Что-то романтичное, что сложно выразить словами", "G"),
        }),
        new("Как бы вы описали свой стиль жизни?", new()
        {
            new("А", "Чёткий и эффективный — без лишнего", "H"),
            new("Б", "Насыщенный, с вниманием к деталям и редким вещам", "I"),
            new("В", "Яркий и заметный — я не теряюсь в толпе", "J"),
        }),
    };

    static readonly Dictionary<string, QuizResult> Results = new()
    {
        ["A"] = new("«Магнитные» неодимовые", "Тип: Тревожный деятель",
            "anti", "bi-magnet", "Антистресс",
            "Вашим рукам нужно быть заняты — так ваша голова наконец успокаивается.",
            "Неодимовые шарики притягиваются и разлетаются сами по себе. Это не просто игрушка — для активных людей с тревожностью это лучший способ перевести фокус и снизить стресс без усилий.",
            47),

        ["B"] = new("«Мала» из рудракши", "Тип: Искатель смысла",
            "rel", "bi-moon-stars", "Религиозные",
            "Вы ищете ответы там, куда большинство не смотрит — внутри себя.",
            "108 зёрен рудракши — семян священного дерева Шивы. В буддийской и индуистской традиции мала помогает войти в состояние глубокой сосредоточенности и обрести внутреннюю тишину.",
            12),

