@page "/quiz"

<PageTitle>Подбор чёток по характеру</PageTitle>

<div class="quiz-page">

    @if (step == QuizStep.Intro)
    {
        <section class="quiz-intro">
            <div class="quiz-intro__bg"></div>
            <div class="container quiz-intro__inner">
                <span class="hero-badge">Персональный подбор</span>
                <h1 class="quiz-intro__title">Какие чётки<br />созданы для вас?</h1>
                <p class="quiz-intro__text">
                    Пройдите 10 вопросов о вашем характере — и мы найдём чётки,
                    которые идеально совпадают с вашей энергетикой
                </p>
                <div class="quiz-intro__features">
                    <span><i class="bi bi-clock me-1"></i>3 минуты</span>
                    <span><i class="bi bi-list-check me-1"></i>10 вопросов</span>
                    <span><i class="bi bi-gem me-1"></i>Персональный результат</span>
                </div>
                <button class="btn btn-gold btn-lg" @onclick="() => step = QuizStep.Questions">
                    <i class="bi bi-play-fill me-2"></i>Начать тест
                </button>
            </div>
        </section>
    }

    else if (step == QuizStep.Questions)
    {
        var q = Questions[current];
        <div class="quiz-question-page">
            <div class="container">

                <div class="quiz-progress">
                    <div class="quiz-progress__track">
                        <div class="quiz-progress__fill" style="width:@((current + 1) * 10)%"></div>
                    </div>
                    <span class="quiz-progress__label">@(current + 1) / @Questions.Count</span>
                </div>

                <div class="quiz-card">
                    <p class="quiz-card__num">Вопрос @(current + 1)</p>
                    <h2 class="quiz-card__question">@q.Text</h2>
                    <div class="quiz-card__options">
                        @foreach (var opt in q.Options)
                        {
                            <button class="quiz-option @(selected == opt.Type ? "quiz-option--chosen" : "")"
                                    @onclick="() => Pick(opt.Type)">
                                <span class="quiz-option__letter">@opt.Letter</span>
                                <span class="quiz-option__text">@opt.Text</span>
                            </button>
                        }
                    </div>
                    @if (selected != null)
                    {
                        <div class="quiz-next-wrap">
                            <button class="btn btn-gold" @onclick="Next">
                                @(current < Questions.Count - 1 ? "Следующий вопрос" : "Узнать результат")
                                <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    }
                </div>

            </div>
        </div>
    }

    else
    {
        var r = GetResult();
        <div class="quiz-result-page">
            <div class="container">
                <div class="quiz-result">

                    <div class="quiz-result__header">
                        <span class="quiz-result__label"><i class="bi bi-stars me-1"></i>Ваш результат</span>
                        <p class="quiz-result__type">@r.TypeLabel</p>
                        <h1 class="quiz-result__title">@r.Name</h1>
                    </div>

                    <div class="quiz-result__cover cat-@r.CatClass">
                        <img src="/images/products/@(r.ProductId).jpeg"
                             alt="@r.Name"
                             class="quiz-result__photo"
                             onerror="this.style.display='none';this.closest('.quiz-result__cover').querySelector('.quiz-result__icon-wrap').style.display='flex'" />
                        <div class="quiz-result__icon-wrap" style="display:none">
                            <i class="bi @r.Icon quiz-result__icon"></i>
                        </div>
                    </div>

                    <blockquote class="quiz-result__quote">@r.PersonalDesc</blockquote>
                    <p class="quiz-result__why">@r.WhyDesc</p>

                    <div class="quiz-result__actions">
                        <a href="/product/@r.ProductId" class="btn btn-gold btn-lg">
                            <i class="bi bi-bag me-2"></i>Открыть товар
                        </a>
                        <a href="/catalog?cat=@Uri.EscapeDataString(r.Category)" class="btn btn-outline-gold btn-lg">
                            <i class="bi bi-grid me-2"></i>Похожие
                        </a>
                        <button class="btn btn-outline-gold btn-lg" @onclick="Restart">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Пройти снова
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@code {
    private enum QuizStep { Intro, Questions, Result }
    private QuizStep step = QuizStep.Intro;
    private int current = 0;
    private string? selected;
    private Dictionary<string, int> scores = new();

    record QuizOption(string Letter, string Text, string Type);
    record QuizQuestion(string Text, List<QuizOption> Options);
    record QuizResult(
