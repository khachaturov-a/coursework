    void Pick(string type) => selected = type;

    void Next()
    {
        if (selected == null) return;
        scores[selected] = scores.GetValueOrDefault(selected) + 1;
        selected = null;
        if (current < Questions.Count - 1) current++;
        else step = QuizStep.Result;
    }

    QuizResult GetResult()
    {
        var winner = scores.OrderByDescending(kv => kv.Value).FirstOrDefault().Key ?? "E";
        return Results.GetValueOrDefault(winner, Results["E"]);
    }

    void Restart()
    {
        step = QuizStep.Intro;
        current = 0;
        selected = null;
        scores.Clear();
    }
}
